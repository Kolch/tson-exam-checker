# Copy to .env and fill in:  cp .env.example .env
# .env stays on this Mac only (it is gitignored). Never commit or share it.

# ===== Required =====

# Номер заявки from the «Первичное получение ВУ» service (digits only)
TSON_APPLICATION_NUMBER=

# The app's passcode («код доступа») you set after logging in
TSON_APP_PIN=

# Telegram bot for alerts: create one with @BotFather, then send /start to it
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== SMS codes (docs/sms.md) =====

# chatdb  = iPhone: Text Message Forwarding to this Mac (most reliable)
# webhook = the phone POSTs each SMS to this Mac (iPhone Shortcut or Android forwarder app)
# manual  = you type codes yourself (first test run only; the daemon can't use it)
SMS_SOURCE=chatdb

# webhook only: port and a random secret the phone must send (openssl rand -hex 16)
SMS_WEBHOOK_PORT=8777
SMS_WEBHOOK_TOKEN=

# ===== Booking (docs/booking-flow.md). A booking can NOT be cancelled. =====

# button = Telegram alert with a «Забронировать» button; books only when you press it
# auto   = books the earliest slot at least TSON_MIN_LEAD_H hours away without asking
# alert  = alert only; you book on your phone
BOOKING_MODE=button
TSON_MIN_LEAD_H=24
TSON_BUTTON_WAIT_MIN=45

# Optional: never book dates in this range (YYYY-MM-DD, inclusive)
TSON_BLACKOUT_FROM=
TSON_BLACKOUT_TO=

# ===== Optional: automatic re-login =====
# The app session expires about every 7 days. With these set, the checker logs
# in again by itself (the SMS code comes through SMS_SOURCE). Without them you
# get a Telegram alert and log in by hand.
# ИИН (12 digits) and phone as +77XXXXXXXXX
TSON_IIN=
TSON_PHONE=

# ===== Schedule =====
# Each check walks the whole flow and costs one SMS code. Random interval in
# minutes, plus a precise check at midnight (new dates often open then).
CHECK_MIN_MIN=10
CHECK_MAX_MIN=20
MIDNIGHT_LEAD_SEC=10

# ===== Environment (defaults fit Homebrew on Apple Silicon) =====
#ANDROID_HOME=/opt/homebrew/share/android-commandlinetools
#TSON_AVD=tson
#APPIUM_SERVER=http://127.0.0.1:4723
#TSON_APP_PACKAGE=kz.gov4c.citizen
